# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=AI Resume Screener
APP_ENV=development
LOG_LEVEL=INFO

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (Streamlit reads this directly, independent of backend config) ---
API_BASE_URL=http://localhost:8000/api/v1

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=data
UPLOAD_DIR_JDS=data/uploads/jds
UPLOAD_DIR_RESUMES=data/uploads/resumes
CHROMA_DIR=data/chroma

# --- LLM provider (swap by changing these two + the matching API key) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_RPM_CAP=8

# --- Provider API keys (only the one matching LLM_PROVIDER/EMBEDDING_PROVIDER is required) ---
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Scoring thresholds (used by services/scoring.py, never hardcoded in prompts) ---
FIT_THRESHOLD_BEST=75
FIT_THRESHOLD_MEDIUM=45

# --- Background pipeline (services/pipeline.py) ---
PIPELINE_MAX_WORKERS=3

# --- CORS (comma-separated origins allowed to call the API; * for local demo) ---
CORS_ORIGINS=*
