# Copy to .env and fill in your key.  cp .env.example .env

# --- AI provider ---------------------------------------------------------
# Swap providers by changing these two lines and setting the matching key.
#   Gemini : LLM_PROVIDER=gemini  LLM_MODEL=gemini-2.5-flash
#   OpenAI : LLM_PROVIDER=openai  LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# Get a free Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Scoring -------------------------------------------------------------
# Overall rating (0-100) cutoffs for the Fit label.
FIT_BEST_MIN=75
FIT_MEDIUM_MIN=45

# --- Storage -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=data/uploads

# --- Runtime -------------------------------------------------------------
# How many resumes to screen at once. Lower this if you hit rate limits.
MAX_PARALLEL_RESUMES=4

# The Vite dev server. Only used if you call the API cross-origin;
# `npm run dev` proxies /api instead, so this rarely matters.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
